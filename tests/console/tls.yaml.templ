apiVersion: apps/v1
kind: Deployment
metadata:
  name: polaris-console
  namespace: ${NAMESPACE}
  labels:
    app: polaris-console
spec:
  replicas: 1
  selector:
    matchLabels:
      app: polaris-console
  template:
    metadata:
      labels:
        app: polaris-console
    spec:
      containers:
        - name: polaris-console
          image: ${IMAGE}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
            - name: https
              containerPort: 8443
          readinessProbe:
            httpGet:
              path: /health
              port: 8443
              scheme: HTTPS
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 8443
              scheme: HTTPS
            periodSeconds: 10
          volumeMounts:
            - name: tls
              mountPath: /etc/nginx/tls
              readOnly: true
      volumes:
        - name: tls
          secret:
            secretName: console-tls
---
apiVersion: v1
kind: Service
metadata:
  name: polaris-console
  namespace: ${NAMESPACE}
  labels:
    app: polaris-console
spec:
  selector:
    app: polaris-console
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      protocol: TCP
    - name: https
      port: 8443
      targetPort: 8443
      protocol: TCP
